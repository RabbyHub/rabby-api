{
  "compilerOptions": {
    "target": "es2016",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "noImplicitAny": true,
    "skipLibCheck": true,
    "outDir": "es",
    "declaration": true,
    "declarationDir": "es",
    "baseUrl": ".",
  },
  "include": ["src"]
}
